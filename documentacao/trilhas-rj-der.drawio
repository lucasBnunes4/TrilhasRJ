                    <mxGeometry height="30" width="1150" x="40" y="730" as="geometry"/>
                </mxCell>
                <mxCell id="notes-1" parent="1" style="text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#456072;" value="Wikiloc · “Hora” → tempo total registrado. “Tempo em movimento” é independente e opcional." vertex="1">
                    <mxGeometry height="30" width="1150" x="40" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="notes-2" parent="1" style="text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#456072;" value="Wikiloc · “Coordenadas” → quantidade de pontos GPS. As latitudes e longitudes exigem geometria ou marcador validado." vertex="1">
                    <mxGeometry height="30" width="1150" x="40" y="790" as="geometry"/>
                </mxCell>
                <mxCell id="notes-3" parent="1" style="text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#456072;" value="Itinerário · tipo_texto = descricao_itinerario. A ordem dos marcadores preserva a sequência exibida pela fonte." vertex="1">
                    <mxGeometry height="30" width="1150" x="40" y="820" as="geometry"/>
                </mxCell>
                <mxCell id="notes-4" parent="1" style="text;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#456072;" value="Catálogo · mantenha os intervalos oficiais e o tipo de duração. Campos ausentes ficam vazios." vertex="1">
